{
  "name": "app-launcher",
  "version": "1.0.0",
  "description": "Desktop launcher for Shiny apps",
  "main": "main.js",
  "scripts": {
    "start": "node sync-config.js && electron .",
    "prebuild": "node sync-config.js",
    "dist:mac": "npm run prebuild && electron-builder --mac --config.mac.identity=null",
    "dist:win": "npm run prebuild && electron-builder --win --x64",
    "dist:all": "npm run dist:mac && npm run dist:win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.tylersolloway.app-launcher",
    "productName": "App Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "RPortable/**/*",
      "launcher.config.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "fileAssociations": [
      {
        "ext": "resondex",
        "name": "App Launcher Bundle",
        "description": "Application bundle for App Launcher",
        "mimeType": "application/x-resondex",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}
